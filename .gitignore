# ==========================================================
# Personal Productivity App - Root .gitignore
# ==========================================================

# Dependencies
node_modules/
*/node_modules/

# Production Build Outputs
dist/
*/dist/
build/
*/build/

# Secrets and Environment Variables (CRITICAL - DO NOT COMMIT)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Runtime Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# System Generated / Artifacts
.system_generated/
