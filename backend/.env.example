# ==========================================================
# Backend Production Environment Variables Template
# ==========================================================
PORT=5000
NODE_ENV=production

# MySQL Database (Railway / Cloud MySQL)
DB_HOST=junction.proxy.rlwy.net
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_railway_mysql_password

# Authentication
JWT_SECRET=super_secret_jwt_key_personal_productivity_app_2026_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Vercel Frontend URL)
FRONTEND_URL=https://productivity-hub.vercel.app

# AI Assistant (Optional)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
