# ==========================================================
# Personal Productivity App - Environment Variables Template
# ==========================================================

# ----------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Set in Railway Dashboard)
# ----------------------------------------------------------
PORT=5000
NODE_ENV=production

# MySQL Database (From Railway MySQL Service)
DB_HOST=junction.proxy.rlwy.net
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_railway_mysql_password

# Authentication (Generate via: openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_personal_productivity_app_2026_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Set to your Vercel Frontend URL)
FRONTEND_URL=https://productivity-hub.vercel.app

# AI Assistant (Optional - Google Gemini or OpenAI)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# ----------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard)
# ----------------------------------------------------------
# Base URL of your deployed Railway Backend REST API
VITE_API_URL=https://productivity-backend.up.railway.app/api
